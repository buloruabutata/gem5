def template MSetTileniDecodeBlock {{
    return new %(class_name)s(machInst, mrlen);
}};


def template MSetTileniExecute {{
    uint32_t
    %(class_name)s::getNewMtilen(
        uint32_t currentMtilen, uint32_t reqMtilen,
        uint32_t mtilenmax, uint64_t rdBits, uint64_t rs1Bits) const
    {

        MTYPE current_mtype;
        uint32_t msew = getMSew(current_mtype.msew);

        uint32_t newMtilen = 0;
        if (mtilenmax == 0) {
            newMtilen = 0;
        } else if (rdBits == 0 && rs1Bits == 0) {
            newMtilen = (currentMtilen > mtilenmax) ? mtilenmax : currentMtilen;
        } else if (rdBits != 0 && rs1Bits == 0) {
            newMtilen = mtilenmax;
        } else if (rs1Bits != 0) {
            newMtilen = (reqMtilen > mtilenmax) ? mtilenmax : reqMtilen;
        }
        return newMtilen;
    }

    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;

        mtilenmax =  getMtilenMax(mrlen, msew);
        uint32_t new_mtilen = getNewMtilen(
            current_mtilen, requested_mtilen, mtilenmax, rd_bits, rs1_bits);
        
        %(write_code)s;

        %(op_wb)s;
        return NoFault;
    }
}};

def template MSetTileniBranchTarget {{
    std::unique_ptr<PCStateBase>
    %(class_name)s::branchTarget(const PCStateBase &branch_pc) const
    {
        auto &rpc = branch_pc.as<RiscvISA::PCState>();

        uint64_t rd_bits = machInst.rd;
        uint64_t rs1_bits = -1;
        uint64_t requested_mtilen = imm10;
        
        MTYPE current_mtype;
        uint32_t msew = getMSew(current_mtype.msew);
        uint32_t mtilenmax =  getMtilenMax(mrlen, msew);
        uint32_t new_mtilen = getNewMtilen(
           rpc.mtilen(), requested_mtilen, mtilenmax, rd_bits, rs1_bits);

        std::unique_ptr<PCState> npc(dynamic_cast<PCState*>(rpc.clone()));
        npc->set(rvSext(npc->pc() + 4));
        npc->mtilen(new_mtilen);
        return npc;
    }
}};