}};

def template MSetTilemiExecute {{
    uint32_t
    %(class_name)s::getNewMtilem(
        uint32_t currentMtilem, uint32_t reqMtilem,
        uint32_t mtilemmax, uint64_t rdBits, uint64_t rs1Bits) const
    {
        uint32_t newMtilem = 0;
        if (mtilemmax == 0) {
            newMtilem = 0;
        } else if (rdBits == 0 && rs1Bits == 0) {
            newMtilem = (currentMtilem > mtilemmax) ? mtilemmax : currentMtilem;
        } else if (rdBits != 0 && rs1Bits == 0) {
            newMtilem = mtilemmax;
        } else if (rs1Bits != 0) {
            newMtilem = (reqMtilem > mtilemmax) ? mtilemmax : reqMtilem;
        }
        return newMtilem;
    }

    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        
        %(op_decl)s;
        %(op_rd)s;
        %(code)s;

        mtilemmax =  getMtilemMax(mlen, mrlen);
        uint32_t new_mtilem = getNewMtilem(
            current_mtilem, requested_mtilem, mtilemmax, rd_bits, rs1_bits);
        
        %(write_code)s;

        %(op_wb)s;
        return NoFault;
    }
}};

def template MSetTilemiBranchTarget {{
    std::unique_ptr<PCStateBase>
    %(class_name)s::branchTarget(const PCStateBase &branch_pc) const
    {
        auto &rpc = branch_pc.as<RiscvISA::PCState>();

        uint64_t rd_bits = machInst.rd;
        uint64_t rs1_bits = -1;
        uint64_t requested_mtilem = imm10;
        

        uint32_t mtilemmax =  getMtilemMax(mlen, mrlen);
        uint32_t new_mtilem = getNewMtilem(
           rpc.mtilem(), requested_mtilem, mtilemmax, rd_bits, rs1_bits);

        std::unique_ptr<PCState> npc(dynamic_cast<PCState*>(rpc.clone()));
        npc->set(rvSext(npc->pc() + 4));
        npc->mtilem(new_mtilem);
        return npc;
    }
}};

